# GitHub OAuth App settings
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# App secret key for session signing (generate with: openssl rand -hex 32)
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

# Admin GitHub usernames (comma-separated)
ADMIN_USERS=yourgithubusername

# Database URL (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./proxy_admin.db

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
